# PlantPulse - Environment Configuration

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=plantpulse
DATABASE_URL=postgresql://postgres:postgres@db:5432/plantpulse

# Redis Event Broker
REDIS_URL=redis://redis:6379/0

# API Service
API_PORT=8001
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# AI Diagnostic Agent (Optional live Gemini API Key, falls back to deterministic engine)
GEMINI_API_KEY=

# Web App Configuration
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_SSE_URL=http://localhost:8001/api/v1/stream/telemetry
PORT=3000
